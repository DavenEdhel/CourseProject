' ============================================================================
' 7) СХЕМЫ АЛГОРИТМОВ (соответствуют Приложению А пояснительной записки)
' ============================================================================
@startuml Algo_A1_GetAgeInYears
title Алгоритм А.1 — Расчёт возраста питомца (GetAgeInYears)
start
:age := today.Year − dateOfBirth.Year;
if (today.Month < dateOfBirth.Month\nИЛИ (today.Month = dateOfBirth.Month\nИ today.Day < dateOfBirth.Day)?) then (да)
  :age := age − 1;
else (нет)
endif
:age := max(age, 0);
:вернуть age;
stop
@enduml

@startuml Algo_A2_BuildAgeHistogram
title Алгоритм А.2 — Построение гистограммы распределения по возрасту
start
:отобрать карточки с заполненной DateOfBirth;
:для каждой карточки вычислить возраст\n(алгоритм А.1);
:сгруппировать карточки по возрасту,\nотсортировать группы по возрастанию;
:maxCount := наибольшее количество\nкарточек в одной группе;
while (для каждой возрастной группы) is (есть ещё)
  if (maxCount = 0?) then (да)
    :BarHeight := 0;
  else (нет)
    :BarHeight := Count / maxCount × 120;
  endif
endwhile (обработаны все)
:сформировать коллекцию AgeHistogram;
stop
@enduml

@startuml Algo_A3_BuildGenderPie
title Алгоритм А.3 — Построение круговой диаграммы соотношения полов
start
:total := общее количество карточек;
:maleCount := количество карточек\nс IsMale = true;
:femaleCount := total − maleCount;
:сформировать подписи с процентным\nсоотношением;
if (total = 0?) then (да)
  :оба сектора — пустая геометрия\n(Geometry.Empty);
  stop
else (нет)
endif
:maleSweep := maleCount / total × 360;
:построить сектор «коты» (0°..maleSweep)\nи сектор «кошки» (maleSweep..360°)\nчерез CreatePieSlice/GetPointOnCircle;
stop
@enduml
