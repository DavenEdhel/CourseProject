<Window x:Class="CourseProject.UI.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CourseProject.UI"
        xmlns:converters="clr-namespace:CourseProject.UI.Converters"
        mc:Ignorable="d"
        FontSize="12"
        Title="Карточка породистого кота" Height="550" Width="400"
        ResizeMode="NoResize">
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <converters:PhotoPathToImageSourceConverter x:Key="PhotoPathToImageSourceConverter" />
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/flowers.png"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ряды 0-7: UniformGrid с двумя колонками -->
        <UniformGrid Columns="4">

            <!-- Заголовок -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock Text=""
                        FontSize="14" FontWeight="Bold" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock Text="Карточка участника"
            FontSize="14" FontWeight="Bold" 
            HorizontalAlignment="Center" VerticalAlignment="Center"
            TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>

            <!-- фото -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Image x:Name="Image"
                    Source="{Binding PhotoPath, Converter={StaticResource PhotoPathToImageSourceConverter}}"
                    Width="170" Height="80"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Stretch="Uniform"
                    Cursor="Hand"
                    MouseLeftButtonDown="Image_MouseLeftButtonDown"
                    ToolTip="Нажмите для выбора фото"/>
            </Grid>
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Image x:Name="Image1"/>
            </Grid>


            <!-- кличка -->
            <Label Content="Кличка:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <TextBox x:Name="TextBoxName" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- порода -->
            <Label Content="Порода:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <TextBox x:Name="TextBoxBreed" Text="{Binding Breed, UpdateSourceTrigger=PropertyChanged}" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- окрас -->
            <Label Content="Окрас:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <TextBox x:Name="TextBoxColor" Text="{Binding Color, UpdateSourceTrigger=PropertyChanged}" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- др -->
            <Label Content="Дата рождения:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <DatePicker x:Name="DatePickerDateOfBirth" SelectedDate="{Binding DateOfBirth}" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- вес -->
            <Label Content="Вес (кг):" FontWeight="Bold" Margin="1,0" VerticalAlignment="Center" FontSize="11"/>
            <StackPanel Margin="1,0" VerticalAlignment="Center">
                <Slider x:Name="SliderWeight" Value="{Binding Weight}" Minimum="1" Maximum="15"
                     TickFrequency="1" IsSnapToTickEnabled="True" Height="18"/>
                <TextBlock Text="{Binding ElementName=SliderWeight, Path=Value, StringFormat={}{0:0}}"
                        HorizontalAlignment="Center" FontWeight="Bold" FontSize="9"/>
            </StackPanel>

            <!-- глаза -->
            <Label Content="Цвет глаз:" FontWeight="Bold" Margin="1,0" VerticalAlignment="Center" FontSize="11"/>
            <ComboBox x:Name="ComboBoxEyes"
                      ItemsSource="{Binding EyeColorOptions}"
                      SelectedItem="{Binding EyeColor}"
                      Margin="1,0" VerticalAlignment="Center" FontSize="11" Height="20"/>




        </UniformGrid>
        <!-- пол -->
        <UniformGrid Grid.Row="1" Columns="1" Margin="1 1 1 10">
            <GroupBox Margin="1,0" FontSize="10" BorderThickness="1" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center" Header="Пол">
                <StackPanel Orientation="Horizontal" >
                    <RadioButton x:Name="RadioButtonMale" Content="Кот"
                                 IsChecked="{Binding IsMale, Mode=OneWay}"
                                 Command="{Binding SetMaleCommand}"
                                 Margin="2,0" FontSize="10"/>
                    <RadioButton x:Name="RadioButtonFemale" Content="Кошка"
                                 IsChecked="{Binding IsMale, Converter={StaticResource InverseBooleanConverter}, Mode=OneWay}"
                                 Command="{Binding SetFemaleCommand}"
                                 Margin="2,0" FontSize="10"/>
                </StackPanel>
            </GroupBox>
        </UniformGrid>
        <!-- чекбокс -->
        <Border Grid.Row="2" Padding="0 5" Background="#90FFFFFF">
            <UniformGrid Columns="1" Margin="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox x:Name="CheckBoxVaccinated" Content="Приавивки" IsChecked="{Binding IsVaccinated}" Margin="3,0" FontSize="12"/>
                    <CheckBox x:Name="CheckBoxSterilized" Content="Стерилизована/Кастрирован" IsChecked="{Binding IsSterilized}" Margin="3,0"/>
                    <CheckBox x:Name="CheckBoxDocumented" Content="Документы" IsChecked="{Binding HasDocuments}" Margin="3,0" FontSize="12"/>
                </StackPanel>
            </UniformGrid>
        </Border>
        <!-- кнопки -->
        <UniformGrid Grid.Row="3" Columns="2" Margin="0,20,0,20">

            <Button x:Name="ButtonSave" Content="Сохранить"
         Margin="15,1" Padding="3,1"
         Background="#FA5772" FontWeight="Bold" FontSize="11"
         Command="{Binding SaveCommand}"/>


            <Button x:Name="ButtonClear" Content="Очистить"
         Margin="15,1" Padding="3,1"
         Background="LightCoral" FontWeight="Bold" FontSize="11"/>


        </UniformGrid>



    </Grid>
</Window>
