<Window x:Class="CourseProject.UI.CardEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CourseProject.UI"
        mc:Ignorable="d"
        FontSize="12"
        Title="Карточка породистого кота" Height="550" Width="400">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/flowers.png"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Ряды 0-7: UniformGrid с двумя колонками -->
        <UniformGrid Columns="4">

            <!-- Заголовок -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock Text=""
                        FontSize="14" FontWeight="Bold" 
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <TextBlock Text="Карточка участника"
            FontSize="14" FontWeight="Bold" 
            HorizontalAlignment="Center" VerticalAlignment="Center"
            TextWrapping="Wrap" TextAlignment="Center"/>
            </Grid>

            <!-- фото -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Image x:Name="image" Source="/Images/no_img.png"
                    Width="170" Height="80"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0"
                    Stretch="Uniform" MouseDown="image_MouseDown"
                    ToolTip="Нажмите для выбора фото"/>
            </Grid>
            <Grid Grid.Column="0" Grid.ColumnSpan="2">
                <Image x:Name="image1"/>
            </Grid>


            <!-- кличка -->
            <Label Content="Кличка:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <TextBox x:Name="textBoxName" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- порода -->
            <Label Content="Порода:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <TextBox x:Name="textBoxBreed" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- окрас -->
            <Label Content="Окрас:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <TextBox x:Name="textBoxColor" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- др -->
            <Label Content="Дата рождения:" FontWeight="Bold" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11"/>
            <DatePicker x:Name="datePickerDOB" Margin="1,5,1,5" VerticalAlignment="Center" FontSize="11" Height="20"/>

            <!-- вес -->
            <Label Content="Вес (кг):" FontWeight="Bold" Margin="1,0" VerticalAlignment="Center" FontSize="11"/>
            <StackPanel Margin="1,0" VerticalAlignment="Center">
                <Slider x:Name="sliderWeight" Minimum="1" Maximum="15" Value="5"
                     TickFrequency="1" IsSnapToTickEnabled="True" Height="18"/>
                <TextBlock Text="{Binding ElementName=sliderWeight, Path=Value, StringFormat={}{0:0}}"
                        HorizontalAlignment="Center" FontWeight="Bold" FontSize="9"/>
            </StackPanel>

            <!-- глаза -->
            <Label Content="Цвет глаз:" FontWeight="Bold" Margin="1,0" VerticalAlignment="Center" FontSize="11"/>
            <ComboBox x:Name="comboBoxEyes" Margin="1,0" VerticalAlignment="Center" FontSize="11" Height="20">
                <ComboBoxItem Content="Зеленые" IsSelected="True"/>
                <ComboBoxItem Content="Голубые"/>
                <ComboBoxItem Content="Желтые"/>
                <ComboBoxItem Content="Карие"/>
            </ComboBox>




        </UniformGrid>
        <!-- пол -->
        <UniformGrid Grid.Row="1" Columns="1" Margin="1 1 1 10">
            <GroupBox Margin="1,0" FontSize="10" BorderThickness="1" Padding="2" HorizontalAlignment="Center" VerticalAlignment="Center" Header="Пол">
                <StackPanel Orientation="Horizontal" >
                    <RadioButton x:Name="radioButtonMale" Content="Кот" Margin="2,0" GroupName="Gender" FontSize="10"/>
                    <RadioButton x:Name="radioButtonFemale" Content="Кошка" Margin="2,0" GroupName="Gender" IsChecked="True" FontSize="10"/>
                </StackPanel>
            </GroupBox>
        </UniformGrid>
        <!-- чекбокс -->
        <Border Grid.Row="2" Padding="0 5" Background="#90FFFFFF">
            <UniformGrid Columns="1" Margin="1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <CheckBox x:Name="checkBoxVaccinated" Content="Приавивки" Margin="3,0" FontSize="12"/>
                    <CheckBox x:Name="checkBoxSterilized" Content="Стерилизована/Кастрирован" Margin="3,0"/>
                    <CheckBox x:Name="checkBoxDocumented" Content="Документы" Margin="3,0" FontSize="12"/>
                </StackPanel>
            </UniformGrid>
        </Border>
        <!-- кнопки -->
        <UniformGrid Grid.Row="3" Columns="3" Margin="0,20,0,20">

            <Button x:Name="buttonLoad" Content="Загрузить"
         Margin="15,1" Padding="3,1"
         Background="#ED7E8D" FontWeight="Bold" FontSize="11"
         Click="ButtonLoad_Click"/>


            <Button x:Name="buttonSave" Content="Сохранить"
         Margin="15,1" Padding="3,1"
         Background="#FA5772" FontWeight="Bold" FontSize="11"
         Click="ButtonSave_Click"/>


            <Button x:Name="buttonClear" Content="Очистить"
         Margin="15,1" Padding="3,1"
         Background="LightCoral" FontWeight="Bold" FontSize="11"
         Click="ButtonClear_Click"/>


        </UniformGrid>



    </Grid>
</Window>
