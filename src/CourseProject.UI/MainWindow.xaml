<Window x:Class="CourseProject.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CourseProject.UI"
        xmlns:converters="clr-namespace:CourseProject.UI.Converters"
        mc:Ignorable="d"
        Background="{StaticResource WindowBackgroundBrush}"
        Title="Питомник — Список питомцев" Height="620" Width="400"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:PhotoPathToOptionalImageSourceConverter x:Key="PhotoPathToOptionalImageSourceConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Питомник" Style="{StaticResource HeadingTextStyle}" Margin="0,0,0,10" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="Добавить"
                    Command="{Binding AddCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,0,8,0"
                    Visibility="{Binding CanManageCards, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Button Content="Статистика"
                    Command="{Binding StatisticsCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Visibility="{Binding CanViewStatistics, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </StackPanel>

        <Border Grid.Row="2"
                Background="{StaticResource PanelOverlayBrush}"
                BorderBrush="{StaticResource BorderPinkBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8"
                Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Поиск по имени:" FontSize="11" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,0,2" />
                <TextBox Text="{Binding NameFilter, UpdateSourceTrigger=PropertyChanged}"
                         Padding="4"
                         Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <RadioButton Content="Все"
                                 GroupName="GenderFilter"
                                 IsChecked="True"
                                 Command="{Binding SetGenderFilterCommand}"
                                 CommandParameter="All"
                                 Margin="0,0,12,0" />
                    <RadioButton Content="Мальчики"
                                 GroupName="GenderFilter"
                                 Command="{Binding SetGenderFilterCommand}"
                                 CommandParameter="Boys"
                                 Margin="0,0,12,0" />
                    <RadioButton Content="Девочки"
                                 GroupName="GenderFilter"
                                 Command="{Binding SetGenderFilterCommand}"
                                 CommandParameter="Girls" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Возраст от" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentTextBrush}" Margin="0,0,4,0" />
                    <TextBox Text="{Binding MinAge, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Width="40" Padding="2" />
                    <TextBlock Text="до" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentTextBrush}" Margin="8,0,4,0" />
                    <TextBox Text="{Binding MaxAge, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}"
                             Width="40" Padding="2" />
                    <TextBlock Text="лет" VerticalAlignment="Center" FontSize="11" Foreground="{StaticResource AccentTextBrush}" Margin="4,0,0,0" />
                </StackPanel>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding CardsView}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderPinkBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Background="White"
                                Padding="8"
                                Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="50" Height="50"
                                        Background="{StaticResource IconButtonBackgroundBrush}"
                                        CornerRadius="4"
                                        VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="🐱"
                                                   FontSize="24"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                        <Image Source="{Binding PhotoPath, Converter={StaticResource PhotoPathToOptionalImageSourceConverter}}"
                                               Stretch="UniformToFill" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" />
                                    <TextBlock Text="{Binding Breed}" FontSize="12" Foreground="Gray" />
                                </StackPanel>

                                <StackPanel Grid.Column="2"
                                            Orientation="Vertical"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Margin="8,0,0,0">
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,4"
                                                Visibility="{Binding Path=DataContext.CanManageCards, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Button Content="✎"
                                                Width="20" Height="20" Padding="0"
                                                Margin="0,0,4,0"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Редактировать"
                                                Command="{Binding Path=DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="✕"
                                                Width="20" Height="20" Padding="0"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="Удалить"
                                                Command="{Binding Path=DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>

                                    <Button Content="🔍"
                                            Width="36" Height="36"
                                            FontSize="18" Padding="0"
                                            Style="{StaticResource IconButtonStyle}"
                                            HorizontalAlignment="Right"
                                            ToolTip="Посмотреть детали карточки"
                                            Command="{Binding Path=DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>
